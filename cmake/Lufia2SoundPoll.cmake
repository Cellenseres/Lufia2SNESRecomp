include_guard(GLOBAL)

# Separate consumer patch copies. Never alter the standalone decomp sources.
function(lufia2_add_sound_poll_patch target core_root)
    get_target_property(_sources lufia2_decomp SOURCES)
    get_target_property(_source_root lufia2_decomp SOURCE_DIR)
    set(_result)
    set(_count 0)
    foreach(_source IN LISTS _sources)
        if(_source MATCHES "/sound_(reply|upload)[.]c$")
            get_filename_component(_absolute "${_source}" ABSOLUTE BASE_DIR "${_source_root}")
            get_filename_component(_name "${_source}" NAME_WE)
            file(READ "${_absolute}" _text)
            if(_name STREQUAL "sound_reply")
                set(_limit SOUND_REPLY_POLL_LIMIT)
                set(_expected 2)
            else()
                set(_limit SOUND_UPLOAD_POLL_LIMIT)
                set(_expected 2)
            endif()
            set(_old "    for (uint32_t polls = 0u; polls < ${_limit}; ++polls) {")
            string(REPLACE "${_old}" "" _removed "${_text}")
            string(LENGTH "${_text}" _before)
            string(LENGTH "${_removed}" _after)
            string(LENGTH "${_old}" _length)
            math(EXPR _matches "(${_before} - ${_after}) / ${_length}")
            if(NOT _matches EQUAL _expected)
                message(FATAL_ERROR "Sound poll patch anchor mismatch: ${_absolute}")
            endif()
            string(REPLACE "${_old}"
                "    const uint32_t limit = Lufia2HostSoundPollLimit(${_limit});\n    for (uint32_t polls = 0u; polls < limit; ++polls) {" _text "${_text}")
            set(_output "${CMAKE_BINARY_DIR}/generated/sound-poll/${_name}.c")
            file(MAKE_DIRECTORY "${CMAKE_BINARY_DIR}/generated/sound-poll")
            file(WRITE "${_output}" "#include \"lufia2_sound_poll.h\"\n${_text}")
            set_source_files_properties("${_output}" TARGET_DIRECTORY lufia2_decomp PROPERTIES
                INCLUDE_DIRECTORIES "${CMAKE_SOURCE_DIR}/src")
            list(APPEND _result "${_output}")
            set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${_absolute}")
            math(EXPR _count "${_count} + 1")
        else()
            list(APPEND _result "${_source}")
        endif()
    endforeach()
    if(NOT _count EQUAL 2)
        message(FATAL_ERROR "Sound poll patch requires exactly reply and upload sources")
    endif()
    set_property(TARGET lufia2_decomp PROPERTY SOURCES "${_result}")
    target_sources(${target} PRIVATE "${CMAKE_SOURCE_DIR}/src/lufia2_sound_poll.c")
    set_property(SOURCE "${CMAKE_SOURCE_DIR}/ports/3ds/host.c" APPEND PROPERTY
        COMPILE_DEFINITIONS LUFIA2_SOUND_POLL_PATCH=1)
endfunction()
