include_guard(GLOBAL)

function(lufia2_add_linear_leaf_entries target snesrecomp_root)
    if(LUFIA2_DECOMP_REFERENCE_ONLY OR NOT EXISTS "${LUFIA2_ROM}")
        return()
    endif()
    set(_metadata_path "${LUFIA2_DECOMP_RESOLVED_ROOT}/metadata/functions.toml")
    if(NOT EXISTS "${_metadata_path}")
        return()
    endif()
    file(READ "${_metadata_path}" _metadata)
    set(_names Lufia2ActorResetTransientState Lufia2WorldMapIndexObjectRecord
        Lufia2WorldMapDisableDisplay Lufia2WorldMapBuildBlockPointer)
    set(_addresses "83:A6DF" "86:E709" "86:973E" "86:AE05")
    foreach(_index RANGE 0 3)
        list(GET _names ${_index} _name)
        list(GET _addresses ${_index} _address)
        string(REGEX MATCH
            "\\[\\[function\\]\\][^[]*name[ \t]*=[ \t]*\"${_name}\"[^[]*"
            _contract "${_metadata}")
        if(NOT _contract MATCHES "address[ \t]*=[ \t]*\"${_address}\"" OR
           NOT _contract MATCHES "status[ \t]*=[ \t]*\"verified\"")
            return()
        endif()
    endforeach()
    get_target_property(_sources ${target} SOURCES)
    foreach(_bank IN ITEMS 83 86)
        set(_original "${LUFIA2_GENERATED_DIR}/bank${_bank}_v2.c")
        if(NOT EXISTS "${_original}")
            return()
        endif()
        file(READ "${_original}" _text)
        if(_bank STREQUAL "83")
            set(_bridge "Lufia2DecompBridge_83A6DF")
        else()
            set(_bridge "Lufia2DecompBridge_86E709")
        endif()
        if(NOT _text MATCHES "extern RecompReturn ${_bridge}\\(CpuState \\*cpu\\)")
            return()
        endif()
        if(_bank STREQUAL "86")
            foreach(_entry IN ITEMS 86973E 86AE05)
                if(NOT _text MATCHES "extern RecompReturn Lufia2DecompBridge_${_entry}\\(CpuState \\*cpu\\)")
                    return()
                endif()
            endforeach()
        endif()
    endforeach()
    set(_arrival_args)
    set(_arrival_header "${LUFIA2_DECOMP_RESOLVED_ROOT}/include/lufia2/world_map.h")
    if(EXISTS "${_arrival_header}")
        file(READ "${_arrival_header}" _arrival_api)
        if(_arrival_api MATCHES "#define LUFIA2_WORLD_ARRIVAL_BOUNDARY_API 1")
            set(_arrival_ready TRUE)
            foreach(_name IN ITEMS Lufia2WorldMapCheckMovingArrival Lufia2WorldMapCheckStoppedArrival)
                if(_name STREQUAL "Lufia2WorldMapCheckMovingArrival")
                    set(_address "86:9AB1")
                else()
                    set(_address "86:9AB8")
                endif()
                string(REGEX MATCH
                    "\\[\\[function\\]\\][^[]*name[ \t]*=[ \t]*\"${_name}\"[^[]*"
                    _contract "${_metadata}")
                if(NOT _contract MATCHES "status[ \t]*=[ \t]*\"verified\"" OR
                   NOT _contract MATCHES "address[ \t]*=[ \t]*\"${_address}\"")
                    set(_arrival_ready FALSE)
                endif()
            endforeach()
            foreach(_entry IN ITEMS 869AB1 869AB8)
                if(NOT _text MATCHES "extern RecompReturn Lufia2DecompBridge_${_entry}\\(CpuState \\*cpu\\)")
                    set(_arrival_ready FALSE)
                endif()
            endforeach()
            if(_arrival_ready)
                list(APPEND _arrival_args --arrival-boundaries)
            endif()
        endif()
    endif()
    set(_directory "${CMAKE_BINARY_DIR}/generated/linear-leaf-entries")
    set(_script "${CMAKE_SOURCE_DIR}/scripts/native_leaf_entries.py")
    execute_process(COMMAND "${CMAKE_COMMAND}" -E env
        "PYTHONDONTWRITEBYTECODE=1" "${Python3_EXECUTABLE}" "${_script}"
        --rom "${LUFIA2_ROM}" --sdk "${snesrecomp_root}"
        --generated "${LUFIA2_GENERATED_DIR}" --out "${_directory}" ${_arrival_args}
        RESULT_VARIABLE _result)
    if(NOT _result EQUAL 0)
        message(FATAL_ERROR "Could not preserve the original native leaf envelopes")
    endif()
    foreach(_bank IN ITEMS 83 86)
        set(_original "${LUFIA2_GENERATED_DIR}/bank${_bank}_v2.c")
        set(_overlay "${_directory}/bank${_bank}_v2.c")
        list(FIND _sources "${_original}" _index)
        if(_index EQUAL -1)
            message(FATAL_ERROR "Missing generated bank${_bank} in ${target}")
        endif()
        list(REMOVE_AT _sources ${_index})
        list(INSERT _sources ${_index} "${_overlay}")
        foreach(_property IN ITEMS COMPILE_DEFINITIONS COMPILE_OPTIONS
                COMPILE_FLAGS INCLUDE_DIRECTORIES LANGUAGE
                COMPILE_DEFINITIONS_RELEASE COMPILE_DEFINITIONS_DEBUG
                COMPILE_DEFINITIONS_RELWITHDEBINFO COMPILE_DEFINITIONS_MINSIZEREL)
            get_source_file_property(_value "${_original}" "${_property}")
            if(NOT _value STREQUAL "NOTFOUND")
                set_property(SOURCE "${_overlay}" PROPERTY "${_property}" "${_value}")
            endif()
        endforeach()
        set_property(SOURCE "${_overlay}" APPEND PROPERTY
            INCLUDE_DIRECTORIES "${LUFIA2_GENERATED_DIR}")
    endforeach()
    set_property(TARGET ${target} PROPERTY SOURCES "${_sources}")
    target_sources(${target} PRIVATE
        "${CMAKE_SOURCE_DIR}/src/decomp_bridge/linear_leaf_body.c")
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS
        "${_script}" "${_metadata_path}")
    if(EXISTS "${_arrival_header}")
        set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${_arrival_header}")
    endif()
endfunction()
