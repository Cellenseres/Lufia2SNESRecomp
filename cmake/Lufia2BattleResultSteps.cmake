include_guard(GLOBAL)

function(lufia2_battle_result_steps_available output)
    set(${output} FALSE PARENT_SCOPE)
    set(_header "${LUFIA2_DECOMP_RESOLVED_ROOT}/include/lufia2/battle_result_steps.h")
    set(_source "${LUFIA2_DECOMP_RESOLVED_ROOT}/src/battle/battle_result_window.c")
    set(_metadata "${LUFIA2_DECOMP_RESOLVED_ROOT}/metadata/functions.toml")
    if(NOT EXISTS "${_header}" OR NOT EXISTS "${_source}" OR NOT EXISTS "${_metadata}")
        return()
    endif()
    file(READ "${_header}" _api)
    file(READ "${_source}" _implementation)
    if(NOT _api MATCHES "Lufia2BattleResultStep[(]" OR
       NOT _implementation MATCHES "Lufia2BattleResultStep[(][^;{]*[{]")
        return()
    endif()
    foreach(_entry IN ITEMS de88 de93 de95 dea2)
        if(NOT _implementation MATCHES "case 0x81${_entry}u:")
            return()
        endif()
    endforeach()
    file(READ "${_metadata}" _functions)
    foreach(_routine IN ITEMS Scroll Wait)
        string(REGEX MATCH
            "\\[\\[function\\]\\][^[]*name[ \t]*=[ \t]*\"Lufia2BattleResultWindow${_routine}\"[^[]*"
            _contract "${_functions}")
        if(_routine STREQUAL "Scroll")
            set(_address "81:DE55")
        else()
            set(_address "81:DE9E")
        endif()
        if(NOT _contract MATCHES "address[ \t]*=[ \t]*\"${_address}\"" OR
           NOT _contract MATCHES "entry_mx[ \t]*=[ \t]*\"M1X0\"" OR
           NOT _contract MATCHES "status[ \t]*=[ \t]*\"verified\"")
            return()
        endif()
    endforeach()
    set(${output} TRUE PARENT_SCOPE)
endfunction()
