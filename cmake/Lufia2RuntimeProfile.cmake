include_guard(GLOBAL)

# Called only by explicitly selected diagnostic builds.
function(lufia2_add_runtime_profile target core_root)
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS
        "${CMAKE_SOURCE_DIR}/scripts/runtime_perf_overlay.py")
    get_target_property(_sources ${target} SOURCES)
    get_target_property(_target_includes ${target} INCLUDE_DIRECTORIES)
    set(_profile_sources)
    foreach(_source IN LISTS _sources)
        get_filename_component(_name "${_source}" NAME)
        set(_kind "")
        if(_name STREQUAL "apu.c")
            set(_kind apu)
        elseif(_name STREQUAL "snes.c")
            set(_kind snes)
        elseif(_name STREQUAL "dsp.c")
            set(_kind dsp)
        elseif(_name STREQUAL "spc.c")
            set(_kind spc)
        elseif(_name STREQUAL "interp_bridge.c")
            set(_kind interp_bridge)
        elseif(_name STREQUAL "interp816.c")
            set(_kind interp)
        elseif(_name STREQUAL "ppu.c")
            set(_kind ppu)
        elseif(_name STREQUAL "common_rtl.c")
            set(_kind rtl)
        elseif(_name STREQUAL "spc_driver.c")
            set(_kind spc_semantic)
        elseif(_name STREQUAL "lufia2_ppu_offload.c")
            set(_kind offload)
        elseif(_name STREQUAL "lufia2_runtime.c")
            set(_kind runtime)
        elseif(_name STREQUAL "lufia2_spc_native.c")
            set(_kind native_spc)
        elseif(_name STREQUAL "audio_trace.c")
            set(_kind audio)
        elseif(_name STREQUAL "ws_shadow.c")
            set(_kind shadow)
        elseif(_name STREQUAL "lufia2_map_widescreen.c")
            set(_kind map)
        elseif(_name STREQUAL "lufia2_intro_widescreen.c")
            set(_kind intro)
        elseif(_name STREQUAL "lufia2_menu_ui_resident.c")
            set(_kind menu)
        elseif(_name STREQUAL "lufia2_battle_ppu_job.c")
            set(_kind battle_job)
        elseif(_name STREQUAL "lufia2_battle_effects.c")
            set(_kind battle_effects)
        elseif(_name STREQUAL "lufia2_battle_ui_resident.c")
            set(_kind battle)
        elseif(_source MATCHES "src/decomp_bridge/(actor_bridge|player_update_bridge)[.]c$")
            set(_kind bridge)
        endif()
        if(NOT _kind)
            list(APPEND _profile_sources "${_source}")
            continue()
        endif()
        set(_overlay "${CMAKE_BINARY_DIR}/generated/runtime-profile/${_kind}/${_name}")
        execute_process(COMMAND "${Python3_EXECUTABLE}"
            "${CMAKE_SOURCE_DIR}/scripts/runtime_perf_overlay.py"
            --input "${_source}" --output "${_overlay}" --kind "${_kind}"
            --bindings "${CMAKE_SOURCE_DIR}/recomp/decomp_bindings.toml"
            COMMAND_ERROR_IS_FATAL ANY)
        get_source_file_property(_includes "${_source}" INCLUDE_DIRECTORIES)
        if(_includes STREQUAL "NOTFOUND")
            set(_includes "")
        endif()
        get_filename_component(_original_directory "${_source}" DIRECTORY)
        set_source_files_properties("${_overlay}" PROPERTIES INCLUDE_DIRECTORIES
            "${_target_includes};${_original_directory};${_includes};${core_root}/runner/src/snes;${core_root}/runner/src;${CMAKE_SOURCE_DIR}/src")
        foreach(_property COMPILE_OPTIONS COMPILE_DEFINITIONS)
            get_source_file_property(_value "${_source}" ${_property})
            if(NOT _value STREQUAL "NOTFOUND")
                set_source_files_properties("${_overlay}" PROPERTIES ${_property} "${_value}")
            endif()
        endforeach()
        list(APPEND _profile_sources "${_overlay}")
    endforeach()
    set_property(TARGET ${target} PROPERTY SOURCES "${_profile_sources}")
    target_sources(${target} PRIVATE "${CMAKE_SOURCE_DIR}/src/lufia2_perf.c")
endfunction()
