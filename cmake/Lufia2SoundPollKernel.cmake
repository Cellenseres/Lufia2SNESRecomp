include_guard(GLOBAL)

# The native patch stage has already checked the pinned upstream hashes.
# Keep the optional dispatch kernel in a further overlay, never fetched code.
function(lufia2_prepare_sound_poll_kernel sources_var)
    set(_result)
    set(_matches 0)
    set(_opcodes 0)
    foreach(_input IN LISTS ${sources_var})
        get_filename_component(_name "${_input}" NAME)
        if(_name STREQUAL "interp_bridge.c")
            file(READ "${_input}" _text)
            set(_anchor "        /* Lufia II $80:9997: CMP long $00:2142; BNE $80:9997.")
            string(REPLACE "${_anchor}" "" _removed "${_text}")
            string(LENGTH "${_text}" _before)
            string(LENGTH "${_removed}" _after)
            string(LENGTH "${_anchor}" _length)
            math(EXPR _delta "${_before} - ${_after}")
            if(NOT _delta EQUAL _length)
                message(FATAL_ERROR "Sound kernel requires exactly one reviewed poll anchor")
            endif()
            string(REPLACE "${_anchor}" "#include \"lufia2_sound_poll_kernel.inc\"\n${_anchor}" _text "${_text}")
            set(_output "${CMAKE_BINARY_DIR}/generated/sound-kernel/interp_bridge.c")
            file(MAKE_DIRECTORY "${CMAKE_BINARY_DIR}/generated/sound-kernel")
            file(WRITE "${_output}" "#include \"lufia2_sound_poll.h\"\n${_text}")
            foreach(_prop COMPILE_DEFINITIONS COMPILE_OPTIONS COMPILE_FLAGS INCLUDE_DIRECTORIES LANGUAGE)
                get_source_file_property(_value "${_input}" "${_prop}")
                if(NOT _value STREQUAL "NOTFOUND")
                    set_property(SOURCE "${_output}" PROPERTY "${_prop}" "${_value}")
                endif()
            endforeach()
            list(APPEND _result "${_output}")
            math(EXPR _matches "${_matches} + 1")
        elseif(_name STREQUAL "interp816.c")
            file(READ "${_input}" _text)
            string(REPLACE "\r\n" "\n" _text "${_text}")
            string(SHA256 _hash "${_text}")
            if(NOT _hash STREQUAL "85d8ea1fad2e9c79c81208312624940ee3b807efe733b37105adf557f7f975ff")
                message(FATAL_ERROR "Sound kernel opcode executor changed: ${_hash}")
            endif()
            string(REPLACE "  interp816_doOpcode(cpu, opcode);"
                "  if (!Lufia2SoundPollOpcode(cpu, opcode, _pcb)) interp816_doOpcode(cpu, opcode);" _text "${_text}")
            set(_output "${CMAKE_BINARY_DIR}/generated/sound-kernel/interp816.c")
            file(WRITE "${_output}" "#if defined(__linux__) && !defined(_GNU_SOURCE)\n#define _GNU_SOURCE 1\n#endif\n#include \"lufia2_sound_poll.h\"\n#include \"interp816.h\"\nstatic bool Lufia2SoundPollOpcode(Interp816 *, uint8_t, uint32_t);\n${_text}\n#include \"lufia2_sound_poll_opcode.inc\"\n")
            get_filename_component(_parent "${_input}" DIRECTORY)
            set_property(SOURCE "${_output}" APPEND PROPERTY INCLUDE_DIRECTORIES "${_parent}")
            foreach(_prop COMPILE_DEFINITIONS COMPILE_OPTIONS COMPILE_FLAGS LANGUAGE)
                get_source_file_property(_value "${_input}" "${_prop}")
                if(NOT _value STREQUAL "NOTFOUND")
                    set_property(SOURCE "${_output}" PROPERTY "${_prop}" "${_value}")
                endif()
            endforeach()
            list(APPEND _result "${_output}")
            math(EXPR _opcodes "${_opcodes} + 1")
        else()
            list(APPEND _result "${_input}")
        endif()
    endforeach()
    if(NOT _matches EQUAL 1 OR NOT _opcodes EQUAL 1)
        message(FATAL_ERROR "Sound kernel expected one interpreter bridge")
    endif()
    set(${sources_var} "${_result}" PARENT_SCOPE)
endfunction()
