include_guard(GLOBAL)

function(lufia2_prepare_apu_clock_state sources_var)
    set(_sources)
    set(_runtime_count 0)
    set(_directory "${CMAKE_BINARY_DIR}/generated/lufia2-apu-state")
    file(MAKE_DIRECTORY "${_directory}")
    foreach(_input IN LISTS ${sources_var})
        get_filename_component(_name "${_input}" NAME)
        if(NOT _name STREQUAL "common_rtl.c")
            list(APPEND _sources "${_input}")
            continue()
        endif()
        file(READ "${_input}" _source)
        string(FIND "${_source}" "static RtlApuFrameClock g_apu_frame_clock;" _clock_at)
        if(_clock_at EQUAL -1)
            message(FATAL_ERROR "APU state requires the reviewed extended frame clock")
        endif()
        set(_output "${_directory}/common_rtl.c")
        file(WRITE "${_output}" "${_source}\n#include \"${CMAKE_SOURCE_DIR}/src/lufia2_apu_clock_state.inc\"\n")
        snesrecomp_platform_copy_source_contract("${_input}" "${_output}")
        get_source_file_property(_includes "${_input}" INCLUDE_DIRECTORIES)
        if(NOT _includes STREQUAL "NOTFOUND")
            set_source_files_properties("${_output}" PROPERTIES INCLUDE_DIRECTORIES "${_includes}")
        endif()
        list(APPEND _sources "${_output}")
        math(EXPR _runtime_count "${_runtime_count}+1")
    endforeach()
    if(NOT _runtime_count EQUAL 1)
        message(FATAL_ERROR "APU state requires exactly one runtime source")
    endif()
    set(${sources_var} "${_sources}" PARENT_SCOPE)
endfunction()
