include_guard(GLOBAL)

function(lufia2_prepare_dsp_state sources_var snesrecomp_root)
    file(READ "${snesrecomp_root}/runner/src/snes/dsp.h" _header)
    string(REPLACE "\r\n" "\n" _header "${_header}")
    string(SHA256 _header_hash "${_header}")
    if(NOT _header_hash STREQUAL "7770f40a323f62087f5ef2068892d202d7b0726a801656fa1bc27fff2c834311")
        message(FATAL_ERROR "DSP state requires its reviewed field layout")
    endif()
    set(_directory "${CMAKE_BINARY_DIR}/generated/lufia2-dsp-state")
    file(MAKE_DIRECTORY "${_directory}")
    set(_sources)
    set(_dsp_count 0)
    set(_runtime_count 0)
    foreach(_input IN LISTS ${sources_var})
        get_filename_component(_name "${_input}" NAME)
        if(NOT _name STREQUAL "dsp.c" AND NOT _name STREQUAL "common_rtl.c")
            list(APPEND _sources "${_input}")
            continue()
        endif()
        file(READ "${_input}" _source)
        string(REPLACE "\r\n" "\n" _source "${_source}")
        if(_name STREQUAL "dsp.c")
            set(_old "void dsp_saveload(Dsp *dsp, SaveLoadInfo *sli) {\n  sli->func(sli, &dsp->ram, sizeof(Dsp) - offsetof(Dsp, ram));\n}")
            set(_new "void Lufia2SaveLoadDspState(Dsp *dsp, SaveLoadInfo *sli);\n\nvoid dsp_saveload(Dsp *dsp, SaveLoadInfo *sli) {\n  Lufia2SaveLoadDspState(dsp, sli);\n}")
            math(EXPR _dsp_count "${_dsp_count}+1")
        else()
            set(_old "#define RTL_SAV_VERSION 9u /* Super FX architectural state in cart_saveload. */")
            set(_new "#define RTL_SAV_VERSION 10u /* Fixed DSP snapshot layout across host ABIs. */")
            math(EXPR _runtime_count "${_runtime_count}+1")
        endif()
        string(FIND "${_source}" "${_old}" _at)
        if(_at EQUAL -1)
            message(FATAL_ERROR "DSP state requires its reviewed ${_name} serializer")
        endif()
        string(REPLACE "${_old}" "${_new}" _source "${_source}")
        if(_name STREQUAL "common_rtl.c")
            string(APPEND _source "\n#include \"${CMAKE_SOURCE_DIR}/src/lufia2_dsp_state.inc\"\n")
        endif()
        set(_output "${_directory}/${_name}")
        file(WRITE "${_output}" "${_source}")
        snesrecomp_platform_copy_source_contract("${_input}" "${_output}")
        get_source_file_property(_includes "${_input}" INCLUDE_DIRECTORIES)
        get_filename_component(_input_directory "${_input}" DIRECTORY)
        if(_includes STREQUAL "NOTFOUND")
            set(_includes "${_input_directory}")
        else()
            list(APPEND _includes "${_input_directory}")
        endif()
        set_source_files_properties("${_output}" PROPERTIES INCLUDE_DIRECTORIES "${_includes}")
        list(APPEND _sources "${_output}")
    endforeach()
    if(NOT _dsp_count EQUAL 1 OR NOT _runtime_count EQUAL 1)
        message(FATAL_ERROR "DSP state requires exactly one DSP and runtime source")
    endif()
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS
        "${snesrecomp_root}/runner/src/snes/dsp.h")
    set(${sources_var} "${_sources}" PARENT_SCOPE)
endfunction()
