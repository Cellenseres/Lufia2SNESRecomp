include_guard(GLOBAL)

function(lufia2_filter_opcode_hook_pages output source)
    set(_from_capacity "enum { kInterpPreOpcodeHookSlots = 192 };")
    set(_to_capacity "enum { kInterpPreOpcodeHookSlots = 512 };")
    set(_from_count "static int s_pre_opcode_hook_count;")
    set(_to_count "static int s_pre_opcode_hook_count;\nstatic uint64_t s_pre_opcode_hook_pages[512];\n/* Slot links use index + 1, so a zeroed page has no hooks. */\nstatic uint16_t s_pre_opcode_hook_heads[32768];\nstatic uint16_t s_pre_opcode_hook_next[kInterpPreOpcodeHookSlots];\n/* Two bytes per hash slot; load is bounded by 512 entries in 1024 slots. */\nstatic uint16_t s_pre_opcode_hook_hash[1024];")
    set(_from_clear "        s_pre_opcode_hook_count = 0;")
    set(_to_clear "        s_pre_opcode_hook_count = 0;\n        memset(s_pre_opcode_hook_pages, 0, sizeof s_pre_opcode_hook_pages);\n        memset(s_pre_opcode_hook_heads, 0, sizeof s_pre_opcode_hook_heads);\n        memset(s_pre_opcode_hook_hash, 0, sizeof s_pre_opcode_hook_hash);")
    set(_from_insert "        s_pre_opcode_hook_count++;")
    set(_to_insert "        s_pre_opcode_hook_next[s_pre_opcode_hook_count] = s_pre_opcode_hook_heads[key >> 8];\n        s_pre_opcode_hook_heads[key >> 8] = (uint16_t)(s_pre_opcode_hook_count + 1);\n        unsigned hash_slot = (key * UINT32_C(2654435761)) >> 22;\n        while (s_pre_opcode_hook_hash[hash_slot]) hash_slot = (hash_slot + 1u) & 1023u;\n        s_pre_opcode_hook_hash[hash_slot] = (uint16_t)(s_pre_opcode_hook_count + 1);\n        s_pre_opcode_hook_count++;\n        s_pre_opcode_hook_pages[key >> 14] |= UINT64_C(1) << ((key >> 8) & 63u);")
    set(_from_dispatch "        if (s_pre_opcode_hook_count > 0) {")
    set(_to_dispatch "        if (s_pre_opcode_hook_count > 0 &&\n            (s_pre_opcode_hook_pages[(pc_before & 0x7fffffu) >> 14] &\n             (UINT64_C(1) << ((pc_before >> 8) & 63u)))) {")
    set(_from_search "            for (int hi = 0; hi < s_pre_opcode_hook_count; hi++) {")
    set(_to_search "            for (unsigned hash_slot = (key * UINT32_C(2654435761)) >> 22;\n                 s_pre_opcode_hook_hash[hash_slot]; hash_slot = (hash_slot + 1u) & 1023u) {\n                const int hi = (int)s_pre_opcode_hook_hash[hash_slot] - 1;")
    foreach(_site IN ITEMS capacity count clear insert dispatch search)
        set(_from "${_from_${_site}}")
        set(_to "${_to_${_site}}")
        string(FIND "${source}" "${_from}" _offset)
        if(_offset EQUAL -1)
            message(FATAL_ERROR "Opcode hook pages require the reviewed registry contract")
        endif()
        string(REPLACE "${_from}" "${_to}" source "${source}")
    endforeach()
    set(${output} "${source}" PARENT_SCOPE)
endfunction()
