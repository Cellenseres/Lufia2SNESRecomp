include_guard(GLOBAL)
include("${CMAKE_CURRENT_LIST_DIR}/Lufia2BattleInputSteps.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/Lufia2WorldFrameLoop.cmake")

function(lufia2_frame_decisions_available output)
    set(${output} FALSE PARENT_SCOPE)
    lufia2_battle_input_steps_available(_battle)
    lufia2_world_frame_loop_available(_world)
    if(NOT _battle OR NOT _world)
        return()
    endif()
    foreach(_family IN ITEMS battle world)
        if(_family STREQUAL "battle")
            set(_header "battle_input_steps.h")
            set(_source "battle/battle_frame_input.c")
            set(_names Lufia2BattleCheckSpriteRequest Lufia2BattleClearSpriteRequest)
        else()
            set(_header "world_scene_returns.h")
            set(_source "world/world_scene.c")
            set(_names Lufia2WorldMapCheckFrameMovement Lufia2WorldMapCheckFramePosition
                Lufia2WorldMapCheckFramePlaneState)
        endif()
        set(_header "${LUFIA2_DECOMP_RESOLVED_ROOT}/include/lufia2/${_header}")
        set(_source "${LUFIA2_DECOMP_RESOLVED_ROOT}/src/${_source}")
        if(NOT EXISTS "${_header}" OR NOT EXISTS "${_source}")
            return()
        endif()
        set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS
            "${_header}" "${_source}")
        file(READ "${_header}" _api)
        file(READ "${_source}" _body)
        foreach(_name IN LISTS _names)
            if(NOT _api MATCHES "${_name}[(]" OR
               NOT _body MATCHES "Lufia2ExecutionResult[ \r\n]+${_name}[(]")
                return()
            endif()
        endforeach()
    endforeach()
    set(${output} TRUE PARENT_SCOPE)
endfunction()
