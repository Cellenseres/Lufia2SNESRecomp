include_guard(GLOBAL)

function(lufia2_nmi_scroll_pairs_available output)
    set(${output} FALSE PARENT_SCOPE)
    set(_header "${LUFIA2_DECOMP_RESOLVED_ROOT}/include/lufia2/system.h")
    set(_source "${LUFIA2_DECOMP_RESOLVED_ROOT}/src/system/nmi_uploads.c")
    if(NOT EXISTS "${_header}" OR NOT EXISTS "${_source}")
        return()
    endif()
    file(READ "${_header}" _declarations)
    file(READ "${_source}" _definitions)
    if(_declarations MATCHES "Lufia2NmiWriteScrollPair\\(" AND
       _definitions MATCHES "Lufia2NmiWriteScrollPair\\(")
        set(${output} TRUE PARENT_SCOPE)
    endif()
endfunction()
